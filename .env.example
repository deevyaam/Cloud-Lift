PORT=3000
BASE_URL=http://localhost:3000

# Microsoft Entra app (Web platform, redirect: BASE_URL/auth/microsoft/callback)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "consumers" = personal OneDrive, "common" = personal + work/school
MS_TENANT=common

# Google Cloud OAuth client (Web app, redirect: BASE_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_KEY=

CONCURRENCY=4
